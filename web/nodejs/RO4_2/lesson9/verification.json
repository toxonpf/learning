      "path": "/js/api.js",
      "status": 200,
      "response": "async function request(url, options = {}) {\n    const response = await fetch(url, options);\n    const data = response.status === 204 ? null : await response.json();\n    if (!response.ok) throw new Error(data?.errors?.join('; ') || data?.message || data?.error || `HTTP ${response.status}`);\n    return data;\n}\nexport function getProducts() { return request('/api/products'); }\nexport function createProduct(product) { return request('/api/products', { method: 'POST', headers: { 'Content-Type': 'application/json', 'x-api-key': 'college-demo' }, body: JSON.stringify(product) }); }\nexport function updateProduct(id, changes) { return request(`/api/products/${id}`, { method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(changes) }); }\nexport function deleteProduct(id) { return request(`/api/products/${id}`, { method: 'DELETE' }); }\n"
    },
    {
      "method": "GET",
      "path": "/js/ui.js",
      "status": 200,
      "response": "const container = document.querySelector('#products');\nconst message = document.querySelector('#message');\nexport function showMessage(text) { message.className = ''; message.textContent = text; }\nexport function showError(text) { message.className = 'error'; message.textContent = `Ошибка: ${text}`; }\nexport function renderProducts(products) {\n    container.replaceChildren();\n    if (!products.length) container.textContent = 'Товаров нет';\n    for (const product of products) {\n        const card = document.createElement('article');\n        for (const [tag, text] of [['h3', product.name], ['p', `Цена: ${product.price} ₸`], ['p', `Категория: ${typeof product.category === 'object' ? product.category?.name : product.category}`], ['p', product.inStock ? 'В наличии' : 'Нет в наличии']]) {\n            const element = document.createElement(tag); element.textContent = text; card.append(element);\n        }\n        for (const [action, text] of [['edit', 'Изменить цену'], ['delete', 'Удалить']]) {\n            const button = document.createElement('button'); button.type = 'button'; button.dataset.action = action; button.dataset.id = product.id; button.textContent = text; card.append(button);\n        }\n        container.append(card);\n    }\n}\n"
    },
