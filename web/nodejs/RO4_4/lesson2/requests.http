@baseUrl = http://localhost:3000

### Состояние
GET {{baseUrl}}/api/status

### Каталог
GET {{baseUrl}}/api/products

### Один товар
GET {{baseUrl}}/api/products/1

### Совместная фильтрация
GET {{baseUrl}}/api/products?category=Accessories&inStock=true&minPrice=10000&maxPrice=50000

### Создать товар (сохраните id ответа в productId)
POST {{baseUrl}}/api/products
Content-Type: application/json
x-api-key: college-demo

{
  "name": "SSD 2TB",
  "price": 65000,
  "categoryId": 1,
  "inStock": true
}

@productId = 6

### Изменить цену
PATCH {{baseUrl}}/api/products/{{productId}}
Content-Type: application/json

{"price": 42000}

### Удалить
DELETE {{baseUrl}}/api/products/{{productId}}

### После удаления — 404
GET {{baseUrl}}/api/products/{{productId}}

### Атомарный заказ (цены назначает сервер)
POST {{baseUrl}}/api/orders
Content-Type: application/json

{"userId":1,"items":[{"productId":1,"quantity":2},{"productId":2,"quantity":1}]}

### Rollback: второй товар отсутствует
POST {{baseUrl}}/api/orders
Content-Type: application/json

{"userId":1,"items":[{"productId":1,"quantity":1},{"productId":999999,"quantity":1}]}

### Регистрация
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{"name":"Кирилл","email":"kirill@example.com","password":"ExamplePassword123!"}

### Вход
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{"email":"kirill@example.com","password":"ExamplePassword123!"}
